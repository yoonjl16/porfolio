---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, url } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag}`} description={`${tag} 태그가 달린 글`}>
  <section class="container-page pt-12 pb-10 sm:pt-16">
    <a href={url('/blog')} class="group inline-flex items-center gap-1.5 text-sm text-muted-fg transition-colors hover:text-fg">
      <Icon name="arrow-left" size={14} class="transition-transform group-hover:-translate-x-0.5" /> Blog
    </a>
    <h1 class="mt-8 font-display text-4xl font-semibold tracking-tight">#{tag}</h1>
    <p class="mt-3 text-muted-fg">{posts.length}개의 글</p>
  </section>
  <section class="container-page">
    <PostList posts={posts} />
  </section>
</Base>
