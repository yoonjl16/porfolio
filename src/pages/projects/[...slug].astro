---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: p }));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, summary, period, role, stack, repo, demo, paper, video } = project.data;
const { Content } = await render(project);

// YouTube 링크(youtu.be / youtube.com/watch?v=)에서 영상 ID 추출
function youtubeId(link?: string) {
  if (!link) return null;
  const u = new URL(link);
  if (u.hostname === 'youtu.be') return u.pathname.slice(1) || null;
  if (u.hostname.endsWith('youtube.com')) return u.searchParams.get('v');
  return null;
}
const videoId = youtubeId(video);
---

<Base title={title} description={summary} ogType="article">
  <article class="container-page pt-12 sm:pt-16">
    <a href={url('/projects')} class="group inline-flex items-center gap-1.5 text-sm text-muted-fg transition-colors hover:text-fg">
      <Icon name="arrow-left" size={14} class="transition-transform group-hover:-translate-x-0.5" /> Projects
    </a>
    <header class="mt-8 border-b border-border pb-8">
      <h1 class="font-display text-4xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-4 text-lg text-muted-fg">{summary}</p>
      <dl class="mt-8 grid grid-cols-2 gap-6 text-sm sm:grid-cols-4">
        <div>
          <dt class="section-label">Period</dt>
          <dd class="mt-1.5">{period}</dd>
        </div>
        <div>
          <dt class="section-label">Role</dt>
          <dd class="mt-1.5">{role}</dd>
        </div>
        <div class="col-span-2">
          <dt class="section-label">Stack</dt>
          <dd class="mt-1.5">{stack.join(' · ')}</dd>
        </div>
      </dl>
      {
        (repo || demo || paper || video) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {repo && (
              <a href={repo} target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center gap-2 rounded-full border border-border px-4 text-sm font-medium transition-colors hover:bg-muted">
                <Icon name="github" size={16} /> Repository
              </a>
            )}
            {demo && (
              <a href={demo} target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center gap-2 rounded-full bg-fg px-4 text-sm font-medium text-bg transition-opacity hover:opacity-85">
                <Icon name="arrow-up-right" size={16} /> Live Demo
              </a>
            )}
            {video && (
              <a href={video} target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center gap-2 rounded-full border border-border px-4 text-sm font-medium transition-colors hover:bg-muted">
                <Icon name="play" size={16} /> 시연 영상
              </a>
            )}
            {paper && (
              <a href={paper} target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center gap-2 rounded-full border border-border px-4 text-sm font-medium transition-colors hover:bg-muted">
                <Icon name="file-text" size={16} /> Paper (DBpia)
              </a>
            )}
          </div>
        )
      }
    </header>
    {
      videoId && (
        <figure class="mt-10">
          <div class="aspect-video overflow-hidden rounded-2xl border border-border bg-muted">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${videoId}`}
              title={`${title} 시연 영상`}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              class="size-full"
            />
          </div>
          <figcaption class="mt-2 text-center text-xs text-muted-fg">시연 영상</figcaption>
        </figure>
      )
    }
    <div class="prose-custom mt-10">
      <Content />
    </div>
  </article>
</Base>
