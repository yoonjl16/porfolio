---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../utils';

const projects = await getProjects();
---

<Base title="Projects" description="직접 설계하고 구현한 프로젝트 모음">
  <section class="container-page pt-16 pb-10 sm:pt-20">
    <p class="section-label rise">Projects</p>
    <h1 class="rise rise-1 mt-3 font-display text-4xl font-semibold tracking-tight">만든 것들</h1>
    <p class="rise rise-2 mt-4 max-w-xl text-muted-fg">
      문제 정의부터 배포까지 직접 진행한 프로젝트입니다. 카드를 누르면 기술적 의사결정과 회고를 볼 수 있습니다.
    </p>
  </section>
  <section class="container-page">
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
