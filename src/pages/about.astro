---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { EXPERIENCE, PROFILE, SKILLS } from '../consts';
---

<Base title="About" description={`${PROFILE.name}에 대하여`}>
  <section class="container-page pt-16 sm:pt-20">
    <p class="section-label rise">About</p>
    <h1 class="rise rise-1 mt-3 font-display text-4xl font-semibold tracking-tight">{PROFILE.name}</h1>
    <p class="rise rise-1 mt-2 inline-flex items-center gap-1.5 text-sm text-muted-fg">
      {PROFILE.role} <span aria-hidden="true">·</span>
      <Icon name="map-pin" size={14} />
      {PROFILE.location}
    </p>

    <div class="prose-custom rise rise-2 mt-10">
      <p>
        안녕하세요. 사용자가 체감하는 품질을 숫자로 증명하는 것을 좋아하는 프론트엔드 개발자입니다. 기능을 "동작하게" 만드는 것을 넘어, 팀이 오래
        유지보수할 수 있는 구조를 고민합니다.
      </p>
      <h2>일하는 방식</h2>
      <ul>
        <li><strong>측정 먼저</strong> — 개선은 Lighthouse, Web Vitals, 사용자 지표로 전후를 비교합니다.</li>
        <li><strong>작게, 자주</strong> — 작은 PR과 명확한 커밋 메시지로 리뷰 비용을 줄입니다.</li>
        <li><strong>기록하기</strong> — 해결한 문제는 블로그와 팀 문서로 남겨 같은 실수를 반복하지 않습니다.</li>
      </ul>
    </div>
  </section>

  <section class="container-page mt-16">
    <h2 class="section-label mb-6">Experience & Education</h2>
    <ol class="divide-y divide-border border-y border-border">
      {
        EXPERIENCE.map((e) => (
          <li class="grid gap-1 py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
            <p class="pt-0.5 font-mono text-xs text-muted-fg">{e.period}</p>
            <div>
              <p class="font-medium">
                {e.title} <span class="font-normal text-muted-fg">· {e.org}</span>
              </p>
              <p class="mt-1 text-sm text-muted-fg">{e.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page mt-16">
    <h2 class="section-label mb-6">Skills</h2>
    <dl class="grid gap-6 sm:grid-cols-2">
      {
        SKILLS.map((s) => (
          <div>
            <dt class="mb-2 text-sm font-medium">{s.group}</dt>
            <dd class="text-sm text-muted-fg">{s.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container-page mt-16">
    <div class="rounded-2xl border border-border bg-card p-8">
      <h2 class="font-display text-2xl font-semibold tracking-tight">함께 일하고 싶으신가요?</h2>
      <p class="mt-2 text-muted-fg">채용, 협업, 커피챗 모두 환영합니다. 이메일로 편하게 연락 주세요.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${PROFILE.email}`} class="inline-flex h-11 items-center gap-2 rounded-full bg-fg px-5 text-sm font-medium text-bg transition-opacity hover:opacity-85">
          <Icon name="mail" size={16} /> 이메일 보내기
        </a>
        {
          PROFILE.resume && (
            <a href={PROFILE.resume} class="inline-flex h-11 items-center gap-2 rounded-full border border-border px-5 text-sm font-medium transition-colors hover:bg-muted">
              <Icon name="file-text" size={16} /> 이력서 PDF
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>
