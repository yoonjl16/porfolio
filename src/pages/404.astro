---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---

<Base title="404" description="페이지를 찾을 수 없습니다">
  <section class="container-page flex flex-col items-start pt-24 sm:pt-32">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight">페이지를 찾을 수 없습니다</h1>
    <p class="mt-4 text-muted-fg">주소가 바뀌었거나 삭제된 페이지일 수 있습니다.</p>
    <a href={url('/')} class="mt-8 inline-flex h-11 items-center rounded-full bg-fg px-5 text-sm font-medium text-bg transition-opacity hover:opacity-85">
      홈으로 돌아가기
    </a>
  </section>
</Base>
