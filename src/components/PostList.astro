---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
  showDescription?: boolean;
}
const { posts, showDescription = true } = Astro.props;
---

<ul class="divide-y divide-border border-y border-border">
  {
    posts.map((post) => (
      <li>
        <a
          href={url(`/blog/${post.id}`)}
          class="group grid gap-1 py-5 sm:grid-cols-[7rem_1fr] sm:gap-6"
        >
          <time datetime={post.data.pubDate.toISOString()} class="pt-0.5 font-mono text-xs text-muted-fg tabular-nums">
            {formatDate(post.data.pubDate)}
          </time>
          <div>
            <h3 class="font-medium leading-snug transition-colors group-hover:text-accent">
              {post.data.title}
            </h3>
            {showDescription && (
              <p class="mt-1 line-clamp-2 text-sm text-muted-fg">{post.data.description}</p>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>
